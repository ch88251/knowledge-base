# Copy to .env. Limits indexing to one Drive folder (and its subfolders).
# Leave empty to index every supported document in your Drive.
KB_DRIVE_FOLDER_ID=

# GitHub personal access token. When set, Markdown files from the public and
# private repositories you own are indexed too. Leave empty to skip GitHub.
KB_GITHUB_TOKEN=
# Set to true to also index repositories you forked.
KB_GITHUB_INCLUDE_FORKS=false
